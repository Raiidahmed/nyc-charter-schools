{
  "name": "nyc-charter-schools",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A map of every charter school in New York City, with filters, commute estimates and the subway.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings src scripts smoke",
    "data": "node scripts/data/fetch.mjs && node scripts/data/build.mjs && node scripts/data/validate.mjs",
    "data:fetch": "node scripts/data/fetch.mjs",
    "data:build": "node scripts/data/build.mjs",
    "data:validate": "node scripts/data/validate.mjs",
    "travel:setup": "bash scripts/travel/setup.sh",
    "travel": "bash scripts/travel/run.sh",
    "smoke": "node smoke/smoke.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-map-gl": "^8.1.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "exceljs": "^4.4.0",
    "mdb-reader": "^3.2.0",
    "oxlint": "^1.91.0",
    "puppeteer-core": "^25.16.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.11"
  }
}
